# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
*.egg-info/

# Environment
.env
token.json
credentials.json

# Node.js (anylist-sidecar)
node_modules/
*.log

# Data (persist locally but don't commit)
data/*.json
# Exception: schedules.json is the default template shipped with the repo
!data/schedules.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.tmp

# Worktrees for parallel branch work (gitignored to avoid recursive tracking)
worktrees/

# Anthropic Office skills — non-redistributable per their LICENSE.txt.
# Re-installed at setup time via scripts/install_office_skills.sh.
.claude/skills/docx/
.claude/skills/pptx/
.claude/skills/xlsx/

# Generated Office artifacts — hand-off only, never commit.
*.docx
*.pptx
*.xlsx
*.pdf
~$*
